---
import '../styles/tokens.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  /** Person JSON-LD belongs on the homepage only. */
  person?: boolean;
}

const { title, description, person = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href.replace(/\/$/, '') || Astro.site!.href;
const ogImage = new URL('/og.png', Astro.site).href;

const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Arsenio Colón',
  alternateName: 'Arsenio Colon',
  url: 'https://arseniocolon.com',
  image: ogImage,
  jobTitle: 'Software Developer II',
  worksFor: { '@type': 'Organization', name: 'Seneca Gaming Corporation' },
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Buffalo',
    addressRegion: 'NY',
    addressCountry: 'US',
  },
  alumniOf: {
    '@type': 'CollegeOrUniversity',
    name: 'State University of New York College at Buffalo',
  },
  knowsAbout: ['C#', '.NET', 'ASP.NET Core', 'SQL', 'Azure DevOps', 'Unity'],
  sameAs: [
    'https://www.linkedin.com/in/arsenio-colon/',
    'https://github.com/Klecoz',
    'https://klecoz.itch.io',
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#f1f3f4" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0d1215" media="(prefers-color-scheme: dark)" />

    <link rel="icon" type="image/svg+xml" href="/logo.svg" />
    {/* No font preloads: the stylesheet is inlined, so @font-face is already in
        the first parse. Preloading on top of that just warns about unused hints. */}

    {person && <script type="application/ld+json" set:html={JSON.stringify(personLd)} />}

    {/* Applies the stored theme before first paint so there's no flash. */}
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('theme');
          if (t === 'dark' || t === 'light') document.documentElement.dataset.theme = t;
        } catch (e) {}
      })();
    </script>

    <script
      data-goatcounter="https://arseniocolon.goatcounter.com/count"
      async
      src="//gc.zgo.at/count.js"></script>
  </head>

  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      // One reveal per section, and only once.
      const targets = document.querySelectorAll<HTMLElement>('.reveal');
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (reduced || !('IntersectionObserver' in window)) {
        targets.forEach((el) => el.classList.add('is-in'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add('is-in');
              io.unobserve(entry.target);
            });
          },
          { rootMargin: '0px 0px -10% 0px' }
        );
        targets.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
