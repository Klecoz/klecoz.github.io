---
import { getCollection, render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';

const games = await Promise.all(
  (await getCollection('games'))
    .sort((a, b) => a.data.order - b.data.order)
    .map(async (e) => ({ ...e, Content: (await render(e)).Content }))
);

const clients = await Promise.all(
  (await getCollection('clients'))
    .sort((a, b) => a.data.order - b.data.order)
    .map(async (e) => ({ ...e, Content: (await render(e)).Content }))
);

/**
 * Built from the same collections the cards render from, so the markup and the
 * structured data can't drift apart. VideoGame for the games, WebSite for the
 * client sites — both are CreativeWork subtypes, and `author` is what ties the
 * list back to the Person on the homepage.
 */
const author = { '@type': 'Person', name: 'Arsenio Colón', url: 'https://arseniocolon.com' };

/**
 * Never `entry.data.image.src` here. That path is the *original* upload, which
 * the build would otherwise drop as an unreferenced 1.3MB of PNGs (see
 * scripts/prune-assets.mjs) — naming it in the JSON-LD pins all ten back into
 * the artifact. Going through getImage() with the same width the cards request
 * reuses a derivative that already ships instead of emitting anything new.
 */
const ldImage = async (img: ImageMetadata) => {
  // Same options the cards pass to <Image>, so this resolves to a derivative
  // the build already emits rather than adding a parallel set.
  const built = await getImage({
    src: img,
    widths: [320, 640],
    sizes: '(max-width: 40rem) 100vw, (max-width: 64rem) 50vw, 21rem',
  });
  const largest = built.srcSet.values.at(-1)?.url ?? built.src;
  return new URL(largest, Astro.site).href;
};

const gameImages = await Promise.all(games.map((g) => ldImage(g.data.image)));
const clientImages = await Promise.all(clients.map((c) => ldImage(c.data.image)));

const itemListLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Side projects — Arsenio Colón',
  numberOfItems: games.length + clients.length,
  itemListElement: [
    ...games.map((g, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      item: {
        '@type': 'VideoGame',
        name: g.data.title,
        author,
        datePublished: g.data.year,
        genre: g.data.tag,
        image: gameImages[i],
        // Every game is a Unity build; the VR ones shipped on Quest.
        gamePlatform: g.data.vr ? ['Meta Quest', 'PC'] : ['PC'],
        ...(g.data.links.length ? { url: g.data.links[0].href } : {}),
      },
    })),
    ...clients.map((c, i) => ({
      '@type': 'ListItem',
      position: games.length + i + 1,
      item: {
        '@type': 'WebSite',
        name: c.data.title,
        creator: author,
        datePublished: c.data.year,
        image: clientImages[i],
        ...(c.data.href ? { url: c.data.href } : {}),
      },
    })),
  ],
};
---

<Base
  title="Side projects — Arsenio Colón"
  description="Unity games built for game jams and hackathons between 2016 and 2023, plus a couple of client sites."
  ogImage="/og-side-projects.png"
  ogImageAlt="Arsenio Colón — Side projects. Games, jams and client work."
>
  <script slot="head" is:inline type="application/ld+json" set:html={JSON.stringify(itemListLd)} />

  <section class="head">
    <div class="wrap">
      <p class="label">Side projects</p>
      <h1>Games and client work</h1>
      <p class="intro">
        Unity games I built for jams and hackathons between 2016 and 2023, plus two sites I made
        for clients. Most of the games have source on GitHub.
      </p>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <div class="section-head">
        <h2>Games</h2>
        <p class="label">{games.length} projects</p>
      </div>

      <ul class="grid">
        {
          games.map(({ data, Content }) => (
            <li class="card reveal">
              <Image
                src={data.image}
                alt={`Screenshot from ${data.title}`}
                widths={[320, 640]}
                sizes="(max-width: 40rem) 100vw, (max-width: 64rem) 50vw, 21rem"
                loading="lazy"
                class="shot"
              />
              <div class="card-body">
                <p class="card-tag mono">
                  {data.vr && <span class="vr">VR</span>}
                  {data.tag} · {data.year}
                </p>
                <h3>{data.title}</h3>
                <div class="card-desc">
                  <Content />
                </div>
                {data.links.length > 0 && (
                  <ul class="card-links">
                    {data.links.map((l) => (
                      <li>
                        <a class="mono" href={l.href}>
                          {l.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="band alt">
    <div class="wrap">
      <div class="section-head">
        <h2>Client work</h2>
        <p class="label">Older</p>
      </div>

      <ul class="grid grid-wide">
        {
          clients.map(({ data, Content }) => (
            <li class="card reveal">
              <Image
                src={data.image}
                alt={`Screenshot of the ${data.title} website`}
                widths={[320, 640]}
                sizes="(max-width: 40rem) 100vw, 25rem"
                loading="lazy"
                class="shot"
              />
              <div class="card-body">
                <p class="card-tag mono">Client · {data.year}</p>
                <h3>{data.title}</h3>
                <div class="card-desc">
                  <Content />
                </div>
                <ul class="card-links">
                  <li>
                    {data.live && data.href ? (
                      <a class="mono" href={data.href}>
                        Visit site
                      </a>
                    ) : (
                      <span class="mono offline">Not online anymore</span>
                    )}
                  </li>
                </ul>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <a class="back mono" href="/">Back to the main page</a>
    </div>
  </section>
</Base>

<style>
  .head { padding-block: var(--s-16) var(--s-8); }
  .head h1 {
    font-size: var(--t-2xl);
    margin-block: var(--s-2) var(--s-4);
  }
  .intro {
    max-width: var(--measure);
    color: var(--muted);
  }

  .band { padding-block: var(--s-12); }
  .alt {
    background: var(--surface);
    border-block: 1px solid var(--rule);
  }

  /* min() on the track minimum, or the grid refuses to shrink below 18rem and
     the page scrolls sideways on a 360px phone. */
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(18rem, 100%), 1fr));
    gap: var(--s-8) var(--s-6);
  }
  .grid-wide {
    grid-template-columns: repeat(auto-fill, minmax(min(22rem, 100%), 1fr));
  }

  .card {
    display: grid;
    grid-template-rows: auto 1fr;
    gap: var(--s-4);
  }

  /* Every card in a row crosses the observer threshold on the same frame, so
     the row lands as one slab. Cycling on 3 instead of a running index reads as
     a left-to-right sweep at three columns and caps the delay at 80ms — short
     enough to disappear at two columns and one, where the cards already enter
     separately and a running index would leave the last one visibly late. */
  .card:nth-child(3n + 2) { transition-delay: 40ms; }
  .card:nth-child(3n) { transition-delay: 80ms; }

  /* 4/3 rather than a wider box because most of these screenshots are square —
     six of the ten sources are 400x400, and cover-cropping those to 16/10 threw
     away over a third of the image, which is what used to slice the Saimon Says
     menu and the Trance Mission title in half. The two panoramic shots lose a
     little off the sides in exchange. */
  .shot {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    background: var(--surface-sunk);
    border: 1px solid var(--rule);
    transition: border-color var(--dur) var(--ease);
  }
  .card:hover .shot { border-color: var(--muted); }

  /* Column rather than a grid so the link row can take margin-top: auto. The
     grid row above already stretches every card in a row to the same height;
     without the auto margin the links sit wherever the description happens to
     end, which puts three of them on three different baselines. */
  .card-body { display: flex; flex-direction: column; gap: var(--s-2); }

  .card-tag {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    font-size: var(--t-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .vr {
    padding: 0.0625rem 0.375rem;
    background: var(--fg);
    color: var(--bg);
    font-weight: 500;
    letter-spacing: 0.1em;
  }

  .card h3 {
    font-size: var(--t-xl);
    line-height: 1.1;
  }

  .card-desc :global(p) {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--muted);
  }

  .card-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-4);
    /* auto pins the row to the bottom of the card; the padding keeps the old
       12px minimum when there is no slack left to absorb. */
    margin-top: auto;
    padding-top: var(--s-1);
    font-size: var(--t-sm);
  }
  /* No opacity: --muted is already the quiet step, and knocking it back another
     quarter dropped this under 4.5:1. It reads as secondary from the mono face
     and the surrounding link colour without help. */
  .offline { color: var(--muted); }

  .back {
    font-size: var(--t-sm);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
</style>
