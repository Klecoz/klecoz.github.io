---
import Base from '../layouts/Base.astro';
---

<Base
  title="Page not found — Arsenio Colón"
  description="That page doesn't exist on arseniocolon.com."
>
  <section class="nf">
    <div class="wrap">
      <p class="label">404</p>
      <h1>That page isn&rsquo;t here</h1>
      <p class="nf-p">
        Either the link is wrong or I moved something. The two pages that do exist are below.
      </p>
      <div class="nf-links">
        <a class="btn-primary" href="/">Main page</a>
        <a class="btn-ghost" href="/side-projects">Side projects</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .nf { padding-block: var(--s-24) var(--s-32); }
  .nf h1 {
    font-size: var(--t-2xl);
    margin-block: var(--s-2) var(--s-4);
  }
  .nf-p {
    max-width: 46ch;
    color: var(--muted);
  }
  .nf-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin-top: var(--s-8);
  }
  .btn-primary,
  .btn-ghost {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: var(--s-3) var(--s-6);
    font-family: var(--f-data);
    font-size: var(--t-sm);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background var(--dur-fast) var(--ease),
                color var(--dur-fast) var(--ease),
                border-color var(--dur-fast) var(--ease);
  }
  .btn-primary {
    background: var(--fg);
    color: var(--bg);
    border: 1px solid var(--fg);
  }
  .btn-primary:hover {
    background: var(--accent-solid);
    border-color: var(--accent-solid);
    color: var(--bg);
  }
  .btn-ghost { border: 1px solid var(--rule); color: var(--fg); }
  .btn-ghost:hover { border-color: var(--fg); }
</style>
