---
import Base from '../layouts/Base.astro';
---

<Base
  title="Page not found — Arsenio Colón"
  description="That page doesn't exist on arseniocolon.com."
>
  {/* GitHub Pages serves this with a real 404 status, so it wouldn't be indexed
      anyway — but the /games and /projects stubs say so explicitly and there's
      no reason for this one to be the exception. */}
  <meta slot="head" name="robots" content="noindex" />

  <section class="nf">
    <div class="wrap">
      <p class="label">404</p>
      <h1>That page isn&rsquo;t here</h1>
      <p class="nf-p">
        Either the link is wrong or I moved something. The two pages that do exist are below.
      </p>
      <div class="nf-links">
        <a class="btn-primary" href="/">Main page</a>
        <a class="btn-ghost" href="/side-projects">Side projects</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .nf { padding-block: var(--s-24) var(--s-32); }
  .nf h1 {
    font-size: var(--t-2xl);
    margin-block: var(--s-2) var(--s-4);
  }
  .nf-p {
    max-width: 46ch;
    color: var(--muted);
  }
  .nf-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin-top: var(--s-8);
  }
  /* .btn-primary / .btn-ghost live in tokens.css — this page used to carry its
     own copy, which had already lost white-space: nowrap. */
</style>
