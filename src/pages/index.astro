---
import Base from '../layouts/Base.astro';
import Timeline from '../components/Timeline.astro';
import EmailReveal from '../components/EmailReveal.astro';

const stack = [
  { group: 'Languages', items: ['C#', 'SQL', 'JavaScript', 'C'] },
  // '.NET 10' holds a literal U+00A0 between the two halves, so the version
  // never wraps away from the platform. Chips render through an expression,
  // which escapes HTML, so a &nbsp; entity would print as text here.
  { group: 'Platforms', items: ['.NET 10', 'ASP.NET Core', 'Azure', 'Kubernetes', 'IIS'] },
  { group: 'Tools', items: ['Azure DevOps', 'Datadog', 'Git', 'Claude Code', 'Unity'] },
];

type CommunityEntry = {
  what: string;
  where: string;
  note: string;
  /** The organisation's own site. */
  href?: string;
  /** A third-party quote that substantiates the entry. Beats asserting it. */
  quote?: { text: string; source: string; href: string };
  /** A plain source link, where there's nothing worth quoting. */
  cite?: { label: string; href: string };
};

const community: CommunityEntry[] = [
  {
    what: 'Secretary, Board of Directors',
    where: 'Buffalo Game Space',
    note: 'A 501(c)(3) supporting local game developers and digital artists.',
    href: 'https://buffalogamespace.com',
    // WGRZ prints "Colon" without the accent. Quoted text stays as printed.
    quote: {
      text: '“Buffalo is in a real great need for developers, musicians, artists. And like, I don’t think that’s gonna stop any time soon.”',
      source: 'WGRZ · November 2019',
      href: 'https://www.wgrz.com/article/news/education/high-school-students-develop-video-games-at-buffalo-stem-event/71-d052e91e-0184-40a8-9695-23b4a66e1b41',
    },
  },
  {
    what: 'Tech Talks and Tech Academy mentoring',
    where: 'M&T Bank',
    note: 'Ran internal workshops and mentored people moving into engineering.',
  },
  {
    what: 'Touchdown for Teachers',
    where: 'M&T Bank',
    note: 'Volunteer program getting supplies and support into local classrooms.',
    cite: {
      label: 'LinkedIn',
      href: 'https://www.linkedin.com/posts/lindsay-gorman-480907224_thank-you-to-our-colleagues-arsenio-col%C3%B3n-share-6885293169357926400-4Ned/',
    },
  },
];
---

<Base
  title="Arsenio Colón — .NET Engineer in Buffalo, NY"
  description="Arsenio Colón is a .NET engineer in Buffalo, NY. Backend systems and internal platforms, currently at Seneca Gaming Corporation."
  person
>
  {/* Old v1 links used hash fragments, which a server never sees. */}
  <script is:inline>
    (function () {
      var h = window.location.hash;
      if (h === '#projects' || h === '#games') {
        window.location.replace('/side-projects');
      }
    })();
  </script>

  <!-- ============ HERO ============ -->
  <section class="hero">
    <div class="wrap">
      <p class="label">Buffalo, NY</p>
      <h1 class="hero-name">Arsenio<br />Colón</h1>
      {/* The middot binds to the word before it, same rule as .stack-items: a
          wrapped line must never open with a separator. */}
      <p class="hero-role">.NET Engineer&nbsp;· Full Stack</p>

      <div class="hero-grid">
        <div class="hero-bio">
          <p>
            I&rsquo;m a .NET engineer in Buffalo. Most of my work is backend and internal
            platforms, the kind of thing other teams end up depending on without thinking
            about it. Right now I&rsquo;m at Seneca Gaming, where I take ownership of our
            internal SharePoint IAM platform, built a visual IT Reporting and Incident
            Dashboard for leadership, and help out with Nintex/WEBCON workflows. My vision
            is to be more proactive and less reactive.
          </p>
          <p>
            I got my start making games for jams, and did AR/VR work for a few years while
            weaving in front-end and backend web development in my day to day.
          </p>
          <div class="hero-cta">
            <a class="btn-primary" href="#work">See the work</a>
            <a class="btn-ghost" href="https://www.linkedin.com/in/arsenio-colon/">LinkedIn</a>
          </div>
        </div>

        <div class="stack">
          {
            stack.map((row) => (
              <div class="stack-row">
                <p class="label">{row.group}</p>
                <ul class="stack-items">
                  {row.items.map((i) => (
                    <li class="mono">{i}</li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- ============ HOW I WORK ============ -->
  <section class="how">
    <div class="wrap how-in reveal">
      <h2 class="label how-h">How I work</h2>
      <p class="how-text">
        I use AI tooling every day, mostly Claude Code CLI. It&rsquo;s good for scaffolding,
        big refactors, and finding my way around code I didn&rsquo;t write. It&rsquo;s changed
        my workflow from thinking about coding to thinking about how Systems and People work
        together.
      </p>
    </div>
  </section>

  <!-- ============ WORK ============ -->
  <section class="band" id="work">
    <div class="wrap">
      {/* The rows below carry their own reveal, so only the head gets one here —
          nesting the two would stagger the same content twice. */}
      <div class="section-head reveal">
        <h2>Work</h2>
        <p class="label">Six roles&nbsp;· 2018 to now</p>
      </div>
      <Timeline />
    </div>
  </section>

  <!-- ============ EDUCATION + COMMUNITY ============ -->
  <section class="band">
    <div class="wrap pair reveal">
      <div>
        <div class="section-head">
          <h2>Education</h2>
        </div>
        <p class="mono edu-when">2015 – 2017</p>
        <h3 class="edu-degree">B.S. Computer Information Systems</h3>
        <p class="edu-school">State University of New York College at Buffalo</p>
        <ul class="notes">
          <li>
            Teaching assistant for Database Systems (SQL and Oracle) and Intro to Computer
            Information Processing.
          </li>
          <li>
            Senior seminar capstone shipped as a playable game and was shown at three regional
            conferences.
            <a
              class="cite"
              href="https://undergraduateresearch.buffalostate.edu/sites/undergraduateresearch/files/documents/SRCC2017program.pdf#page=39"
            >
              Buffalo State SRCC&nbsp;2017 <span class="weight">·&nbsp;PDF&nbsp;12MB</span>
            </a>
          </li>
        </ul>
      </div>

      <div>
        <div class="section-head">
          <h2>Community</h2>
        </div>
        <ul class="notes community">
          {
            community.map((c) => (
              <li>
                <p class="c-what">{c.what}</p>
                <p class="c-where mono">
                  {c.href ? <a href={c.href}>{c.where}</a> : c.where}
                </p>
                <p class="c-note">{c.note}</p>
                {c.quote && (
                  <blockquote class="pull">
                    <p>{c.quote.text}</p>
                    <footer>
                      <a href={c.quote.href}>{c.quote.source}</a>
                    </footer>
                  </blockquote>
                )}
                {c.cite && (
                  <a class="cite" href={c.cite.href}>
                    {c.cite.label}
                  </a>
                )}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- ============ SIDE PROJECTS TEASER ============ -->
  <section class="teaser">
    <div class="wrap teaser-in reveal">
      <div>
        <p class="label">Side projects</p>
        <h2 class="teaser-h">Eight games and a couple of client sites</h2>
        <p class="teaser-p">
          Unity games built for jams and hackathons between 2016 and 2023, including a VR tower
          defense that took second place at ACV&rsquo;s hackathon. Most of them have source.
        </p>
      </div>
      <a class="btn-primary" href="/side-projects">Browse them</a>
    </div>
  </section>

  <!-- ============ CONTACT ============ -->
  <section class="band" id="contact">
    <div class="wrap reveal">
      <div class="section-head">
        <h2>Contact</h2>
      </div>
      <div class="contact">
        <p class="contact-p">
          I&rsquo;m around if you want to talk about a role, or just about the work.
        </p>
        <EmailReveal />
        <ul class="links">
          <li>
            <span class="label">LinkedIn</span>
            <a class="mono" href="https://www.linkedin.com/in/arsenio-colon/">
              /in/arsenio-colon
            </a>
          </li>
          <li>
            <span class="label">GitHub</span>
            <a class="mono" href="https://github.com/Klecoz">github.com/Klecoz</a>
          </li>
          <li>
            <span class="label">itch.io</span>
            <a class="mono" href="https://klecoz.itch.io">klecoz.itch.io</a>
          </li>
        </ul>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ---------- hero ---------- */
  .hero { padding-block: var(--s-16) var(--s-12); }

  .hero-name {
    font-size: var(--t-display);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    /* 0.88 clipped the acute on the Ó against the line above. */
    line-height: 0.94;
    margin-block: var(--s-3) var(--s-4);
  }

  .hero-role {
    font-family: var(--f-display);
    font-size: var(--t-xl);
    font-weight: 600;
    color: var(--muted);
    padding-bottom: var(--s-8);
    border-bottom: 3px solid var(--rule-heavy);
  }

  /* Asymmetric: prose takes the wide column, the stack sits in a narrow rail. */
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.65fr) minmax(0, 1fr);
    gap: var(--s-12);
    padding-top: var(--s-8);
  }

  .hero-bio {
    display: grid;
    gap: var(--s-4);
    max-width: var(--measure);
  }
  .hero-bio p { color: var(--muted); }

  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin-top: var(--s-4);
  }

  .stack { display: grid; gap: var(--s-6); align-content: start; }
  .stack-row { display: grid; gap: var(--s-2); }
  .stack-items {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-1) var(--s-3);
    font-size: var(--t-sm);
    color: var(--fg);
  }
  /* Separator rides on the *preceding* item so a wrapped line never starts
     with an orphaned dot. */
  .stack-items li:not(:last-child)::after {
    content: '·';
    color: var(--rail);
    margin-left: var(--s-3);
  }

  /* ---------- buttons: one label per intent, site-wide ---------- */
  .btn-primary,
  .btn-ghost {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: var(--s-3) var(--s-6);
    font-family: var(--f-data);
    font-size: var(--t-sm);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    transition: background var(--dur-fast) var(--ease),
                color var(--dur-fast) var(--ease),
                border-color var(--dur-fast) var(--ease);
  }
  .btn-primary {
    background: var(--fg);
    color: var(--bg);
    border: 1px solid var(--fg);
  }
  .btn-primary:hover {
    background: var(--accent-solid);
    border-color: var(--accent-solid);
    color: var(--bg);
  }
  .btn-ghost {
    border: 1px solid var(--rule);
    color: var(--fg);
  }
  .btn-ghost:hover { border-color: var(--fg); color: var(--fg); }

  /* ---------- how I work ---------- */
  .how {
    border-block: 1px solid var(--rule);
    background: var(--surface);
  }
  .how-in {
    display: grid;
    grid-template-columns: 8rem minmax(0, 1fr);
    gap: var(--s-4);
    padding-block: var(--s-8);
  }
  /* An h2 so the section lands in the document outline; .label carries the look,
     so the display-face line-height from the base h2 rule gets undone here. */
  .how-h { line-height: 1.65; }
  .how-text {
    max-width: var(--measure);
    font-size: var(--t-lg);
    line-height: 1.6;
  }

  /* ---------- generic band ---------- */
  .band { padding-block: var(--s-16); }

  /* ---------- education + community ---------- */
  /* min() on the track minimum, or the two columns refuse to shrink below 19rem
     and the page scrolls sideways at 320px. */
  .pair {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(19rem, 100%), 1fr));
    gap: var(--s-16) var(--s-12);
  }
  .edu-when {
    font-size: var(--t-sm);
    color: var(--muted);
  }
  .edu-degree {
    font-size: var(--t-xl);
    margin-block: var(--s-1) 0.125rem;
  }
  .edu-school { font-size: var(--t-lg); font-weight: 500; }

  .notes {
    display: grid;
    gap: var(--s-4);
    margin-top: var(--s-6);
    max-width: 44ch;
  }
  .notes > li {
    position: relative;
    padding-left: var(--s-4);
    font-size: 0.96875rem;
    color: var(--muted);
  }
  .notes > li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.65em;
    width: 0.4375rem;
    height: 1px;
    background: var(--rule);
  }
  .community > li { padding-left: 0; }
  .community > li::before { display: none; }
  .community > li + li {
    padding-top: var(--s-4);
    border-top: 1px solid var(--rule);
  }
  .c-what { color: var(--fg); font-weight: 500; line-height: 1.35; }
  .c-where {
    font-size: var(--t-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    margin-block: 0.125rem var(--s-1);
  }
  .c-note { font-size: 0.9375rem; }

  /* ---------- citations ----------
     One treatment for every source on the page, so three references don't read
     as three one-offs. The arrow marks it as leaving the site. */
  .cite {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4em;
    margin-top: var(--s-2);
    padding-bottom: 0.15em;
    font-family: var(--f-data);
    font-size: var(--t-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    text-decoration: none;
    border-bottom: 1px solid var(--rule);
    transition: color var(--dur-fast) var(--ease),
                border-color var(--dur-fast) var(--ease);
  }
  .cite:hover { color: var(--fg); border-bottom-color: var(--accent); }
  .cite::after { content: '↗'; font-size: 0.9em; color: var(--accent); }
  /* The file weight is a warning, not a label — 12MB on cellular is an ambush. */
  .cite .weight { color: var(--rail); letter-spacing: 0.04em; }

  /* A board seat is easy to assert; this is someone else confirming it. The only
     third-party voice on the site, so it gets the accent rule. */
  .pull {
    margin: var(--s-4) 0 0;
    padding-left: var(--s-4);
    border-left: 3px solid var(--accent);
  }
  .pull p { font-size: var(--t-base); line-height: 1.55; color: var(--fg); }
  .pull footer {
    margin-top: var(--s-2);
    font-family: var(--f-data);
    font-size: var(--t-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .pull footer a { text-decoration: none; border-bottom: 1px solid var(--rule); }
  .pull footer a:hover { border-bottom-color: var(--accent); }

  /* ---------- teaser: full-bleed band breaks the stack ---------- */
  .teaser {
    background: var(--surface);
    border-block: 1px solid var(--rule);
  }
  .teaser-in {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--s-8);
    padding-block: var(--s-12);
  }
  .teaser-h {
    font-size: var(--t-2xl);
    margin-block: var(--s-2) var(--s-3);
    max-width: 20ch;
  }
  .teaser-p {
    max-width: 54ch;
    color: var(--muted);
  }

  /* ---------- contact ---------- */
  .contact { display: grid; gap: var(--s-6); justify-items: start; }
  .contact-p {
    font-size: var(--t-lg);
    max-width: 46ch;
  }
  .links {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, max-content));
    gap: var(--s-6) var(--s-12);
    margin-top: var(--s-2);
  }
  .links li { display: grid; gap: 0.125rem; }
  .links a { font-size: var(--t-base); }

  /* ---------- print ---------- */
  @media print {
    /* Navigation, not information — a paper CTA goes nowhere. */
    .hero-cta,
    .teaser .btn-primary { display: none; }

    /* The arrow is a screen affordance, and these hrefs run past 100 characters —
       the WGRZ one alone takes three lines and swamps the quote. Killed rather
       than printed, because the visible label already names the source. These
       need page-level specificity to beat the global a[href^=http] rule. */
    .cite::after,
    .pull footer a::after { content: none; }
    .cite { border-bottom: none; padding-bottom: 0; }

    /* On screen the surface bands break the vertical stack; on paper the rules
       already do that, and a tinted block just costs ink. */
    .how,
    .teaser { background: none; }

    .hero { padding-block: 0 var(--s-8); }
    .hero-grid { gap: var(--s-6); }
    .hero-role { padding-bottom: var(--s-4); }
  }

  /* ---------- narrow ---------- */
  @media (max-width: 52rem) {
    .hero-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s-8);
    }
    .how-in { grid-template-columns: minmax(0, 1fr); gap: var(--s-2); }
    .hero { padding-block: var(--s-12) var(--s-8); }
    .band { padding-block: var(--s-12); }
  }

  @media (max-width: 34rem) {
    .hero-cta { display: grid; }
    .btn-primary, .btn-ghost { justify-content: center; }
  }
</style>
