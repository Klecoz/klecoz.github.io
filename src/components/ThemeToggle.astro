---
// Icons are inline SVG (Lucide sun / moon). No icon font, no emoji.
//
// Two stops. There is no `system` stop: dark is the default a cold visitor
// lands on regardless of `prefers-color-scheme`, and light is one click away.
// The server renders `dark` because that is what an unvisited browser gets;
// the inline script below corrects a returning visitor before paint.
---

<button class="toggle" type="button" data-theme-toggle data-state="dark" aria-label="Colour theme: Dark">
  <span class="t-i" aria-hidden="true">
    <svg class="i-light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"
         stroke-linecap="round">
      <circle cx="12" cy="12" r="4" />
      <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" />
    </svg>
    <svg class="i-dark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"
         stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" />
    </svg>
  </span>
  <span class="t-l mono" data-theme-label>Dark</span>
</button>

{/* Runs at parse position, before paint, for the same reason the no-flash script
    in Base.astro does: the server can't know which stop is stored, so it renders
    `dark`, and a returning visitor on light would otherwise watch the label
    correct itself. `is:inline` keeps it out of the module graph so it isn't
    deferred. */}
<script is:inline>
  (function () {
    var btn = document.querySelector('[data-theme-toggle]');
    if (!btn) return;
    try {
      if (localStorage.getItem('theme') !== 'light') return;
      btn.dataset.state = 'light';
      var label = btn.querySelector('[data-theme-label]');
      if (label) label.textContent = 'Light';
      btn.setAttribute('aria-label', 'Colour theme: Light');
    } catch (e) {}
  })();
</script>

<style>
  .toggle {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    min-height: 2.25rem;
    flex: none;
    padding: 0 var(--s-3);
    background: none;
    /* --rule-control, not --rule: this border is the control's only boundary. */
    border: 1px solid var(--rule-control);
    color: var(--fg);
    cursor: pointer;
    transition: color var(--dur-fast) var(--ease),
                border-color var(--dur-fast) var(--ease);
  }
  .toggle:hover { border-color: var(--fg); }
  .toggle:hover .t-i { color: var(--fg); }

  .t-i { display: grid; color: var(--muted); transition: color var(--dur-fast) var(--ease); }
  .t-i svg { width: 1rem; height: 1rem; grid-area: 1 / 1; }

  .t-l {
    font-size: var(--t-xs);
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  /* The icon names the stop you are *on*, which the visible label repeats. That
     stays as it was under three stops: it is the reading the label enforces, and
     flipping it back to "click for this" now would silently invert the meaning
     of an icon people have already learned. */
  .i-light, .i-dark { display: none; }
  .toggle[data-state='light'] .i-light { display: block; }
  .toggle[data-state='dark'] .i-dark { display: block; }

  /* Below 34rem the label costs about 66px the nav doesn't have — the wordmark
     and three links already fill the row, and the label is what pushed "Side
     projects" onto a second line at 320px. The control keeps both stops and its
     accessible name; only the visible word goes, so nothing here has to satisfy
     SC 2.5.3 any more. */
  @media (max-width: 34rem) {
    .toggle {
      gap: 0;
      padding: 0;
      width: 2rem;
      min-height: 2rem;
      /* justify-content, not the justify-items half of `place-items`, which a
         flex container ignores — that left the 16px icon flush against the
         border with all 14px of slack on its right. */
      justify-content: center;
    }
    .t-l { display: none; }
  }
</style>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const label = btn?.querySelector<HTMLElement>('[data-theme-label]');
  const root = document.documentElement;

  type Stop = 'dark' | 'light';

  const stored = (): Stop => {
    try {
      return localStorage.getItem('theme') === 'light' ? 'light' : 'dark';
    } catch {
      return 'dark';
    }
  };

  // Dark is written to storage as well as light. It is not the absence of a
  // preference — it is the default, and if the default ever changes, a visitor
  // who chose dark should keep dark rather than inherit the new one.
  const apply = (stop: Stop) => {
    root.dataset.theme = stop;
    try {
      localStorage.setItem('theme', stop);
    } catch {
      /* private mode — the choice still holds for this page view */
    }

    document
      .querySelector<HTMLMetaElement>('meta[name="theme-color"]')
      ?.setAttribute('content', stop === 'dark' ? '#0d1215' : '#f1f3f4');

    if (btn) {
      const name = stop === 'dark' ? 'Dark' : 'Light';
      btn.dataset.state = stop;
      if (label) label.textContent = name;
      // Keeps SC 2.5.3 satisfied: the visible word is inside the accessible name.
      btn.setAttribute('aria-label', `Colour theme: ${name}`);
    }
  };

  btn?.addEventListener('click', () => {
    apply(stored() === 'dark' ? 'light' : 'dark');
  });
</script>
